namespace Demo
{
    /// The wave slope as a tangent-space normal map value.
    shader WaterWaveNormal : ComputeColor, WaterWaves
    {
        override float4 Compute()
        {
            float2 gradient;
            Waves(gradient);
            float3 n = normalize(float3(-gradient.x * 0.6, -gradient.y * 0.6, 1.0));
            return float4(n * 0.5 + 0.5, 1);
        }
    };
}
