namespace Demo
{
    /// One thread per brick: a brick is active this step when it, or one of its six neighbours,
    /// changed on the previous step (or was marked from the CPU by a dig or a pour). Water crosses
    /// at most one cell per step, so a change can only reach the next brick over.
    shader VoxelWaterSpread : ComputeShaderBase
    {
        stage Texture3D<uint> ChangedBricks;
        stage RWTexture3D<uint> ActiveOut;
        stage int3 BrickCount;

        uint Changed(int3 b)
        {
            if (any(b < 0) || any(b >= BrickCount))
                return 0;
            return ChangedBricks.Load(int4(b, 0));
        }

        override void Compute()
        {
            int3 b = int3(streams.DispatchThreadId);
            if (any(b >= BrickCount))
                return;
            uint active = Changed(b)
                | Changed(b + int3(1, 0, 0)) | Changed(b - int3(1, 0, 0))
                | Changed(b + int3(0, 1, 0)) | Changed(b - int3(0, 1, 0))
                | Changed(b + int3(0, 0, 1)) | Changed(b - int3(0, 0, 1));
            ActiveOut[b] = active != 0 ? 1 : 0;
        }
    };
}
