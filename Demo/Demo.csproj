<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The demo IS the game: one project, no per-platform head to maintain. Stride picks its
         graphics API from StridePlatform (Direct3D11 on Windows, Vulkan elsewhere), so it is set
         from whatever machine is building — which is what makes `dotnet run` work on all three. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <StrideProjectType>Executable</StrideProjectType>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)Demo.sdpkg</StrideCurrentPackagePath>
    <StridePlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">Windows</StridePlatform>
    <StridePlatform Condition="$([MSBuild]::IsOSPlatform('Linux'))">Linux</StridePlatform>
    <StridePlatform Condition="$([MSBuild]::IsOSPlatform('OSX'))">macOS</StridePlatform>

    <!-- Which backend to build against. Stride derives it from StridePlatform when it is empty,
         which on Windows means Direct3D11 - so leaving it alone changes nothing. Setting it here
         makes it selectable from the command line:

             dotnet build Demo/Demo.csproj -p:StrideGraphicsApi=Direct3D12

         The package references are filtered by this property during *restore*, not during build,
         so a switch needs the restore to run again - which it does on its own when the property
         changes, and which is why passing it to a plain incremental build silently kept the old
         backend. Each non-default API gets its own bin/ so the three do not overwrite each other's
         assemblies; Direct3D11 keeps bin/Debug/net10.0 where everything already looks for it. -->
    <StrideGraphicsApi Condition="'$(StrideGraphicsApi)' == ''">Direct3D11</StrideGraphicsApi>
    <BaseOutputPath Condition="'$(StrideGraphicsApi)' != 'Direct3D11'">bin\$(StrideGraphicsApi)\</BaseOutputPath>
    <Nullable>enable</Nullable>
    <RootNamespace>Demo</RootNamespace>
    <AssemblyName>Demo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.Video" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.Physics" Version="$(StrideVersion)" />
    <!-- SCAFFOLDING (voxelgrid probe), not for commit -->
    <PackageReference Include="Stride.BepuPhysics" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.BepuPhysics.Debug" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.Navigation" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.Particles" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.UI" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.AssetCompiler" Version="$(StrideVersion)" IncludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetData\StrideVoxelGI\StrideVoxelGI.csproj" />
  </ItemGroup>
</Project>
